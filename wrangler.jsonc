{
  "name": "pathpilot-sgp",
  "compatibility_date": "2026-08-13",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    // Plain project URL, not a secret — already public in the frontend bundle.
    // SUPABASE_SERVICE_ROLE_KEY is NOT here: it must be added as an encrypted
    // secret via the Cloudflare dashboard (Workers & Pages -> this worker ->
    // Settings -> Variables and Secrets), never committed to the repo.
    "SUPABASE_URL": "https://lkhfsmmvrukszfhpfffo.supabase.co"
  }
}
